LeanPML.PML.weakCoefficientMul_value (D : LeanPML.Rectangle.Rect) (m : LeanPML.PML.RegionalWeakCoefficient D)
  (u : ↥(LeanPML.Rectangle.zeroBoundaryGraph D)) : ↑(LeanPML.PML.weakCoefficientMul D m u) 0 = m.value.operator (↑↑u 0)
LeanPML.PML.weakCoefficientMul_derivatives (D : LeanPML.Rectangle.Rect) (m : LeanPML.PML.RegionalWeakCoefficient D)
  (u : ↥(LeanPML.Rectangle.zeroBoundaryGraph D)) :
  ↑(LeanPML.PML.weakCoefficientMul D m u) 1 = (m.derivative 0).operator (↑↑u 0) + m.value.operator (↑↑u 1) ∧
    ↑(LeanPML.PML.weakCoefficientMul D m u) 2 = (m.derivative 1).operator (↑↑u 0) + m.value.operator (↑↑u 2)
