  (f : LeanPML.Rectangle.TestFunction D) (i : Fin 2) :
  LeanPML.Rectangle.HasWeakPartial D i (m.value.operator ((LeanPML.Rectangle.SmoothField.toL2 D) f.field))
    ((m.derivative i).operator ((LeanPML.Rectangle.SmoothField.toL2 D) f.field) +
      m.value.operator ((LeanPML.Rectangle.SmoothField.toL2 D) (LeanPML.Rectangle.smoothPartial i f.field)))
