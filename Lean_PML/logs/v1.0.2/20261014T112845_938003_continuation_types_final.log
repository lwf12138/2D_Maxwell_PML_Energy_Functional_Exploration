LeanPML.Rectangle.poincare_integral_top_zero (a b : ℝ × ℝ) (hab : a ≤ b) (f : ℝ × ℝ → ℝ) (hf : ContDiff ℝ (↑⊤) f)
  (hboundary : ∀ x ∈ Set.Icc a.1 b.1, f (x, b.2) = 0) :
  ∫ (z : ℝ × ℝ) in Set.Icc a b, f z ^ 2 ≤
    (2 * (b.2 - a.2)) ^ 2 * ∫ (z : ℝ × ℝ) in Set.Icc a b, (fderiv ℝ f z) (0, 1) ^ 2
LeanPML.Rectangle.smooth_directional_poincare (D : LeanPML.Rectangle.Rect) (f : LeanPML.Rectangle.SmoothField)
  (htrace : LeanPML.Rectangle.ZeroBoundary D ↑f) (i : Fin 2) :
  ‖(LeanPML.Rectangle.SmoothField.toL2 D) f‖ ^ 2 ≤
    LeanPML.Rectangle.directionalPoincareConstant D i ^ 2 *
      ‖(LeanPML.Rectangle.SmoothField.toL2 D) (LeanPML.Rectangle.smoothPartial i f)‖ ^ 2
LeanPML.Rectangle.weak_directional_poincare (D : LeanPML.Rectangle.Rect) (v : ↥(LeanPML.Rectangle.zeroBoundaryGraph D))
  (i : Fin 2) :
  ‖↑↑v 0‖ ^ 2 ≤
    LeanPML.Rectangle.directionalPoincareConstant D i ^ 2 * ‖↑↑v (LeanPML.Rectangle.partialGraphIndex i)‖ ^ 2
LeanPML.Rectangle.weak_zero_of_partial_zero (D : LeanPML.Rectangle.Rect) (v : ↥(LeanPML.Rectangle.zeroBoundaryGraph D))
  (i : Fin 2) (hpartial : ↑↑v (LeanPML.Rectangle.partialGraphIndex i) = 0) : v = 0
LeanPML.Rectangle.weak_zero_of_dx_zero (D : LeanPML.Rectangle.Rect) (v : ↥(LeanPML.Rectangle.zeroBoundaryGraph D))
  (hx : ↑↑v 1 = 0) : v = 0
LeanPML.Rectangle.weak_zero_of_dy_zero (D : LeanPML.Rectangle.Rect) (v : ↥(LeanPML.Rectangle.zeroBoundaryGraph D))
  (hy : ↑↑v 2 = 0) : v = 0
LeanPML.Rectangle.nonzero_directional_poincare_call (i : Fin 2) :
  ↑↑LeanPML.Rectangle.directionalExample 0 ≠ 0 ∧
    ‖↑↑LeanPML.Rectangle.directionalExample 0‖ ^ 2 ≤
      LeanPML.Rectangle.directionalPoincareConstant LeanPML.Rectangle.ParameterCertificate.unitSquare i ^ 2 *
        ‖↑↑LeanPML.Rectangle.directionalExample (LeanPML.Rectangle.partialGraphIndex i)‖ ^ 2
LeanPML.Analysis.regularized_memory_rate_le.{u_1} {H : Type u_1} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  (B : H →L[ℝ] H) (hB : ∀ (X : H), 0 ≤ inner ℝ X (B X)) (X F : H) {δ : ℝ} (hδ : 0 < δ) :
  2 * inner ℝ X (-B X + F) / (2 * √(‖X‖ ^ 2 + δ)) ≤ ‖F‖
LeanPML.Analysis.regularized_memory_bound.{u_1} {H : Type u_1} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  (B : H →L[ℝ] H) (hB : ∀ (X : H), 0 ≤ inner ℝ X (B X)) (W F : ℝ → H) {T t δ : ℝ} (hW : ContinuousOn W (Set.Icc 0 T))
  (hF : ContinuousOn F (Set.Icc 0 T)) (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt W (-B (W s) + F s) s) (ht : t ∈ Set.Icc 0 T)
  (hδ : 0 < δ) : √(‖W t‖ ^ 2 + δ) ≤ √(‖W 0‖ ^ 2 + δ) + ∫ (s : ℝ) in 0..t, ‖F s‖
LeanPML.Analysis.norm_le_initial_add_integral_forcing.{u_1} {H : Type u_1} [NormedAddCommGroup H]
  [InnerProductSpace ℝ H] (B : H →L[ℝ] H) (hB : ∀ (X : H), 0 ≤ inner ℝ X (B X)) (W F : ℝ → H) {T t : ℝ}
  (hW : ContinuousOn W (Set.Icc 0 T)) (hF : ContinuousOn F (Set.Icc 0 T))
  (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt W (-B (W s) + F s) s) (ht : t ∈ Set.Icc 0 T) :
  ‖W t‖ ≤ ‖W 0‖ + ∫ (s : ℝ) in 0..t, ‖F s‖
LeanPML.Analysis.square_intervalIntegral_le_mul_integral_square (g : ℝ → ℝ) {t : ℝ} (ht : 0 ≤ t)
  (hg : ContinuousOn g (Set.Icc 0 t)) : (∫ (s : ℝ) in 0..t, g s) ^ 2 ≤ t * ∫ (s : ℝ) in 0..t, g s ^ 2
LeanPML.Analysis.dissipative_memory_square_bound.{u_1} {H : Type u_1} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  (B : H →L[ℝ] H) (hB : ∀ (X : H), 0 ≤ inner ℝ X (B X)) (W F : ℝ → H) {T t : ℝ} (hW : ContinuousOn W (Set.Icc 0 T))
  (hF : ContinuousOn F (Set.Icc 0 T)) (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt W (-B (W s) + F s) s)
  (ht : t ∈ Set.Icc 0 T) : ‖W t‖ ^ 2 ≤ 2 * ‖W 0‖ ^ 2 + 2 * t * ∫ (s : ℝ) in 0..t, ‖F s‖ ^ 2
LeanPML.PML.SpatialAbsorption.weighted_absorption_inner_nonneg.{u_1} {α : Type u_1} [MeasurableSpace α]
  (ν : MeasureTheory.Measure α) (C : LeanPML.PML.SpatialAbsorption α) (X : ↥(LeanPML.Analysis.WeightedL2 ν C.wx)) :
  0 ≤ inner ℝ X ((LeanPML.Analysis.weightedMul ν C.wx C.pCoeff.value ⋯ C.pCoeff.bound ⋯) X)
LeanPML.PML.SpatialAbsorption.auxiliary_weighted_memory_bound.{u_1} {α : Type u_1} [MeasurableSpace α] [Nonempty α]
  (ν : MeasureTheory.Measure α) (C : LeanPML.PML.SpatialAbsorption α) (W₀ : ↥(LeanPML.Analysis.WeightedL2 ν C.wx))
  (φ h l : ℝ → ↥(LeanPML.Analysis.ScalarL2 ν)) (T : ℝ) (hφ : ContinuousOn φ (Set.Icc 0 T))
  (hh : ContinuousOn h (Set.Icc 0 T)) (hl : ContinuousOn l (Set.Icc 0 T))
  (hinitial : (LeanPML.Analysis.physicalL2 ν C.wx ⋯ ⋯) W₀ = φ 0)
  (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt φ ((C.rCoeff.operator ν) (h s) - (C.pCoeff.operator ν) (l s)) s)
  (hspace : ∀ s ∈ Set.Ioo 0 T, l s = h s + φ s) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  ‖LeanPML.PML.SpatialAbsorption.auxiliaryWeightedHistory ν C W₀ h l t‖ ^ 2 ≤
    2 * ‖W₀‖ ^ 2 + 4 * C.c * C.S * t * ∫ (s : ℝ) in 0..t, ‖h s‖ ^ 2
LeanPML.PML.SpatialAbsorption.auxiliary_weighted_integral_bound.{u_1} {α : Type u_1} [MeasurableSpace α] [Nonempty α]
  (ν : MeasureTheory.Measure α) (C : LeanPML.PML.SpatialAbsorption α) (W₀ : ↥(LeanPML.Analysis.WeightedL2 ν C.wx))
  (φ h l : ℝ → ↥(LeanPML.Analysis.ScalarL2 ν)) (T : ℝ) (hφ : ContinuousOn φ (Set.Icc 0 T))
  (hh : ContinuousOn h (Set.Icc 0 T)) (hl : ContinuousOn l (Set.Icc 0 T))
  (hinitial : (LeanPML.Analysis.physicalL2 ν C.wx ⋯ ⋯) W₀ = φ 0)
  (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt φ ((C.rCoeff.operator ν) (h s) - (C.pCoeff.operator ν) (l s)) s)
  (hspace : ∀ s ∈ Set.Ioo 0 T, l s = h s + φ s) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  MeasureTheory.Integrable (fun x => C.wx x * ↑↑(φ t) x ^ 2) ν ∧
    ∫ (x : α), C.wx x * ↑↑(φ t) x ^ 2 ∂ν ≤ 2 * ‖W₀‖ ^ 2 + 4 * C.c * C.S * t * ∫ (s : ℝ) in 0..t, ‖h s‖ ^ 2
LeanPML.PML.SpatialAbsorption.auxiliary_weak_memory_bound (D : LeanPML.Rectangle.Rect)
  (C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)) (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx))
  (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx)) (φx φy : ℝ → ↥(LeanPML.Analysis.ScalarL2 D.measure))
  (u : ℝ → ↥(LeanPML.Rectangle.weakH1Graph D)) (L : ℝ → ↥(LeanPML.Rectangle.weakHDivGraph D)) (T : ℝ)
  (hφx : ContinuousOn φx (Set.Icc 0 T)) (hφy : ContinuousOn φy (Set.Icc 0 T)) (hu : ContinuousOn u (Set.Icc 0 T))
  (hL : ContinuousOn L (Set.Icc 0 T)) (hinitial_x : (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = φx 0)
  (hinitial_y : (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = φy 0)
  (hODE_x :
    ∀ s ∈ Set.Ioo 0 T,
      HasDerivAt φx ((C.rCoeff.operator D.measure) (↑(u s) 1) - (C.pCoeff.operator D.measure) (↑(L s) 0)) s)
  (hODE_y :
    ∀ s ∈ Set.Ioo 0 T,
      HasDerivAt φy ((C.swap.rCoeff.operator D.measure) (↑(u s) 2) - (C.swap.pCoeff.operator D.measure) (↑(L s) 1)) s)
  (hspace_x : ∀ s ∈ Set.Ioo 0 T, ↑(L s) 0 = ↑(u s) 1 + φx s) (hspace_y : ∀ s ∈ Set.Ioo 0 T, ↑(L s) 1 = ↑(u s) 2 + φy s)
  {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  ‖LeanPML.PML.SpatialAbsorption.auxiliaryWeightedHistory D.measure C W₀x (fun s => ↑(u s) 1) (fun s => ↑(L s) 0) t‖ ^
        2 +
      ‖LeanPML.PML.SpatialAbsorption.auxiliaryWeightedHistory D.measure C.swap W₀y (fun s => ↑(u s) 2)
            (fun s => ↑(L s) 1) t‖ ^
        2 ≤
    2 * (‖W₀x‖ ^ 2 + ‖W₀y‖ ^ 2) + 4 * C.c * C.S * t * ∫ (s : ℝ) in 0..t, ‖↑(u s) 1‖ ^ 2 + ‖↑(u s) 2‖ ^ 2
LeanPML.Examples.WeightedEvolution.nonzero_memory_bound (T t : ℝ) (ht : t ∈ Set.Icc 0 T) :
  LeanPML.Examples.WeightedEvolution.f ≠ 0 ∧
    ‖LeanPML.PML.SpatialAbsorption.auxiliaryWeightedHistory LeanPML.Rectangle.ParameterCertificate.unitSquare.measure
            LeanPML.Examples.WeightedEvolution.coefficients LeanPML.Examples.WeightedEvolution.initial (fun x => 0)
            LeanPML.Examples.WeightedEvolution.path t‖ ^
        2 ≤
      2 * ‖LeanPML.Examples.WeightedEvolution.initial‖ ^ 2
