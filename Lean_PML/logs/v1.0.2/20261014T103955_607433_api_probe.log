Continuous.norm.{u_1, u_4} {α : Type u_1} {E : Type u_4} [SeminormedAddGroup E] [TopologicalSpace α] {f : α → E} :
  Continuous f → Continuous fun x => ‖f x‖
Submodule.topologicalClosure_minimal.{u, v} {R : Type u} {M : Type v} [Semiring R] [TopologicalSpace M]
  [AddCommMonoid M] [Module R M] [ContinuousConstSMul R M] [ContinuousAdd M] (s : Submodule R M) {t : Submodule R M}
  (h : s ≤ t) (ht : IsClosed ↑t) : s.topologicalClosure ≤ t
