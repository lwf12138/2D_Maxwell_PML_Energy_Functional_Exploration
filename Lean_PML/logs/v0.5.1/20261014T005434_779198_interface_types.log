structure LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions {D : LeanPML.Rectangle.Rect}
  {R : LeanPML.Rectangle.RegionalAbsorption D} {ε κ τ μ T : ℝ}
  (s : LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution R ε κ τ μ T) : Prop
number of parameters: 8
fields:
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.antitone : AntitoneOn s.energy (Set.Icc 0 T)
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.law : ∀ t ∈ Set.Ioo 0 T,
      HasDerivAt s.energy (-s.dissipation t) t ∧
        (LeanPML.PML.fieldSpatialDissipation D.measure R.coefficients (s.problem.path.base t) +
                  LeanPML.PML.scaleK ε κ μ (LeanPML.Rectangle.poincareConstant D) *
                    LeanPML.PML.fieldSpatialDissipation D.measure R.coefficients (s.problem.path.first t)) /
                2 +
              μ * τ / (4 * κ) *
                (‖(s.problem.path.first t).R‖ ^ 2 +
                  LeanPML.PML.scaleK ε κ μ (LeanPML.Rectangle.poincareConstant D) * ‖(s.problem.path.second t).R‖ ^ 2) ≤
            s.dissipation t ∧
          0 ≤ s.dissipation t
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.graph_bounds : ∀ t ∈ Set.Icc 0 T,
      s.graphSquare t / 4 ≤ s.energy t ∧ s.energy t ≤ s.graphSquare t
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.initial_bounds : ∀ t ∈ Set.Icc 0 T,
      0 ≤ s.energy t ∧ s.energy t ≤ s.energy 0
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.physical : ∀ t ∈ Set.Icc 0 T,
      ε * ‖s.electricL2 t‖ ^ 2 + μ * (‖s.magneticXL2 t‖ ^ 2 + ‖s.magneticYL2 t‖ ^ 2) + κ⁻¹ * ‖s.polarL2 t‖ ^ 2 ≤
        4 / μ * s.energy t
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.physical_initial : ∀ t ∈ Set.Icc 0 T,
      ε * ‖s.electricL2 t‖ ^ 2 + μ * (‖s.magneticXL2 t‖ ^ 2 + ‖s.magneticYL2 t‖ ^ 2) + κ⁻¹ * ‖s.polarL2 t‖ ^ 2 ≤
        4 / μ * s.energy 0
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.balance : ∀ (t₁ t₂ : ℝ),
      0 ≤ t₁ → t₁ ≤ t₂ → t₂ ≤ T → s.energy t₂ + ∫ (t : ℝ) in t₁..t₂, s.dissipation t = s.energy t₁
constructor:
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions.mk {D : LeanPML.Rectangle.Rect}
    {R : LeanPML.Rectangle.RegionalAbsorption D} {ε κ τ μ T : ℝ}
    {s : LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution R ε κ τ μ T}
    (antitone : AntitoneOn s.energy (Set.Icc 0 T))
    (law :
      ∀ t ∈ Set.Ioo 0 T,
        HasDerivAt s.energy (-s.dissipation t) t ∧
          (LeanPML.PML.fieldSpatialDissipation D.measure R.coefficients (s.problem.path.base t) +
                    LeanPML.PML.scaleK ε κ μ (LeanPML.Rectangle.poincareConstant D) *
                      LeanPML.PML.fieldSpatialDissipation D.measure R.coefficients (s.problem.path.first t)) /
                  2 +
                μ * τ / (4 * κ) *
                  (‖(s.problem.path.first t).R‖ ^ 2 +
                    LeanPML.PML.scaleK ε κ μ (LeanPML.Rectangle.poincareConstant D) *
                      ‖(s.problem.path.second t).R‖ ^ 2) ≤
              s.dissipation t ∧
            0 ≤ s.dissipation t)
    (graph_bounds : ∀ t ∈ Set.Icc 0 T, s.graphSquare t / 4 ≤ s.energy t ∧ s.energy t ≤ s.graphSquare t)
    (initial_bounds : ∀ t ∈ Set.Icc 0 T, 0 ≤ s.energy t ∧ s.energy t ≤ s.energy 0)
    (physical :
      ∀ t ∈ Set.Icc 0 T,
        ε * ‖s.electricL2 t‖ ^ 2 + μ * (‖s.magneticXL2 t‖ ^ 2 + ‖s.magneticYL2 t‖ ^ 2) + κ⁻¹ * ‖s.polarL2 t‖ ^ 2 ≤
          4 / μ * s.energy t)
    (physical_initial :
      ∀ t ∈ Set.Icc 0 T,
        ε * ‖s.electricL2 t‖ ^ 2 + μ * (‖s.magneticXL2 t‖ ^ 2 + ‖s.magneticYL2 t‖ ^ 2) + κ⁻¹ * ‖s.polarL2 t‖ ^ 2 ≤
          4 / μ * s.energy 0)
    (balance :
      ∀ (t₁ t₂ : ℝ), 0 ≤ t₁ → t₁ ≤ t₂ → t₂ ≤ T → s.energy t₂ + ∫ (t : ℝ) in t₁..t₂, s.dissipation t = s.energy t₁) :
    LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions s
LeanPML.PML.SmoothRectangle.main_energy_estimate_smoothRectangle {D : LeanPML.Rectangle.Rect}
  {R : LeanPML.Rectangle.RegionalAbsorption D} {ε κ τ μ T : ℝ}
  (s : LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution R ε κ τ μ T) :
  LeanPML.PML.SmoothRectangle.SmoothEnergyConclusions s
LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution.energy_eq_original_integrals {D : LeanPML.Rectangle.Rect}
  {R : LeanPML.Rectangle.RegionalAbsorption D} {ε κ τ μ T : ℝ}
  (s : LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution R ε κ τ μ T) (t : ℝ) :
  s.energy t =
    ∫ (X : ℝ × ℝ), R.energyDensity ε κ τ μ (s.problem.path.base t) X ∂D.measure +
      LeanPML.PML.scaleK ε κ μ (LeanPML.Rectangle.poincareConstant D) *
        ∫ (X : ℝ × ℝ), R.energyDensity ε κ τ μ (s.problem.path.first t) X ∂D.measure
LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution.physical_current_bound {D : LeanPML.Rectangle.Rect}
  {R : LeanPML.Rectangle.RegionalAbsorption D} {ε κ τ μ T : ℝ}
  (s : LeanPML.PML.SmoothRectangle.SmoothCompatibleSolution R ε κ τ μ T) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  ε * ‖s.electricL2 t‖ ^ 2 + μ * (‖s.magneticXL2 t‖ ^ 2 + ‖s.magneticYL2 t‖ ^ 2) + κ⁻¹ * ‖s.polarL2 t‖ ^ 2 ≤
    4 / μ * s.energy t
