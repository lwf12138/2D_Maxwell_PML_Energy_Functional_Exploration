theorem LeanPML.PML.Weak.main_energy_estimate_RegionalWeak : ∀ (D : LeanPML.Rectangle.Rect)
  (A : LeanPML.PML.WeakRegionalAbsorption D) (ε κ τ μ T : ℝ),
  0 < ε →
    0 < κ →
      0 < τ →
        0 < μ →
          A.c ≤ LeanPML.PML.threshold ε κ τ μ (LeanPML.Rectangle.poincareConstant D) →
            ∀ (O : LeanPML.PML.Weak.OriginalInterval D A.spatial ε κ τ μ T) (J : LeanPML.PML.Weak.OriginalJet O)
              (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure A.spatial.wx))
              (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure A.spatial.swap.wx)),
              (LeanPML.Analysis.physicalL2 D.measure A.spatial.wx ⋯ ⋯) W₀x = O.φx 0 →
                (LeanPML.Analysis.physicalL2 D.measure A.spatial.swap.wx ⋯ ⋯) W₀y = O.φy 0 →
                  LeanPML.PML.Weak.DegenerateJetCompatibility O J → O.EnergyConclusions J W₀x W₀y :=
fun D A ε κ τ μ T hε hκ hτ hμ hsmall O J W₀x W₀y hWx hWy hdeg =>
  have hp :=
    { ε_pos := hε, κ_pos := hκ, τ_pos := hτ, μ_pos := hμ, CP_pos := LeanPML.Rectangle.poincareConstant_pos D,
      c_le_threshold := hsmall };
  LeanPML.PML.Weak.OriginalInterval.main_energy_estimate_WeakOriginal O J W₀x W₀y hp hWx hWy hdeg
theorem LeanPML.PML.Weak.OriginalInterval.main_energy_estimate_WeakOriginal : ∀ {D : LeanPML.Rectangle.Rect}
  {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε κ τ μ T : ℝ} (O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T)
  (J : LeanPML.PML.Weak.OriginalJet O) (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx))
  (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx)),
  LeanPML.PML.CoercivityParameters C ε κ τ μ (LeanPML.Rectangle.poincareConstant D) →
    (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = O.φx 0 →
      (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = O.φy 0 →
        LeanPML.PML.Weak.DegenerateJetCompatibility O J → O.EnergyConclusions J W₀x W₀y :=
fun {D} {C} {ε κ τ μ T} O J W₀x W₀y hp hWx hWy hdeg =>
  let problem := O.finiteProblem J W₀x W₀y hWx hWy hdeg;
  have hmain :=
    LeanPML.PML.main_energy_estimate_Conditional (LeanPML.Rectangle.weakGreenDomain D) C ε κ τ μ
      (LeanPML.Rectangle.poincareConstant D) T hp (fun v x => LeanPML.Rectangle.weak_poincare_domain D v) problem
      J.continuous_polarDDot;
  { bounds := fun t ht => (hmain.right.right.left t ht).left, law := fun t ht => hmain.right.left t ht,
    monotone := hmain.left, initial_bounds := fun t ht => (hmain.right.right.left t ht).right.left,
    integrable := fun t₁ t₂ h₁ h₁₂ h₂ =>
      LeanPML.PML.intervalIntegrable_dissipation7_Conditional (LeanPML.Rectangle.weakGreenDomain D) C ε κ τ μ
        (LeanPML.Rectangle.poincareConstant D) T (fun v x => LeanPML.Rectangle.weak_poincare_domain D v) problem
        J.continuous_polarDDot h₁ h₁₂ h₂,
    balance := hmain.right.right.right,
    physical := fun t ht =>
      have hcontrol :=
        LeanPML.PML.physicalControl_Conditional D.measure C ε κ τ μ (LeanPML.Rectangle.poincareConstant D) hp
          (LeanPML.Rectangle.weakGreenDomain D).spatial (LeanPML.Rectangle.weakPoincareDomain D)
          (O.sameSource J W₀x W₀y) t (problem.static_base t ht) (problem.static_first t ht);
      have hmagnetic := LeanPML.PML.Weak.OriginalInterval.magnetic_reconstruction O W₀x W₀y (ne_of_gt hp.μ_pos) ht;
      have hphysical := hcontrol.physical;
      Eq.mp
        (congrFun'
          (congrArg LE.le
            (congrFun'
              (congrArg HAdd.hAdd
                (congrArg (HAdd.hAdd (ε * ‖(O.fields t).E‖ ^ 2))
                  (congrArg (HMul.hMul μ)
                    (congr (congrArg HAdd.hAdd (congrFun' (congrArg HPow.hPow (congrArg norm hmagnetic.left)) 2))
                      (congrFun' (congrArg HPow.hPow (congrArg norm hmagnetic.right)) 2)))))
              (κ⁻¹ * ‖(O.fields t).P‖ ^ 2)))
          (4 / μ * O.energy J W₀x W₀y t))
        hphysical,
    physical_initial := fun t ht =>
      have hcontrol := (hmain.right.right.left t ht).right.right.right.physical;
      have hmagnetic := LeanPML.PML.Weak.OriginalInterval.magnetic_reconstruction O W₀x W₀y (ne_of_gt hp.μ_pos) ht;
      id
        (fun hcontrol =>
          Eq.mp
            (congrFun'
              (congrArg LE.le
                (congrFun'
                  (congrArg HAdd.hAdd
                    (congrArg (HAdd.hAdd (ε * ‖(O.fields t).E‖ ^ 2))
                      (congrArg (HMul.hMul μ)
                        (congr (congrArg HAdd.hAdd (congrFun' (congrArg HPow.hPow (congrArg norm hmagnetic.left)) 2))
                          (congrFun' (congrArg HPow.hPow (congrArg norm hmagnetic.right)) 2)))))
                  (κ⁻¹ * ‖(O.fields t).P‖ ^ 2)))
              (4 / μ * O.energy J W₀x W₀y 0))
            hcontrol)
        hcontrol }
theorem LeanPML.Examples.WeakStaticMode.nonzero_static_regression : ∀ (T : ℝ) (hT : 0 ≤ T) {t : ℝ},
  t ∈ Set.Ioo 0 T →
    0 <
        (LeanPML.Examples.WeakStaticMode.solution T hT).energy (LeanPML.Examples.WeakStaticMode.jet T hT) 0
          LeanPML.Examples.WeakStaticMode.initialY t ∧
      (LeanPML.Examples.WeakStaticMode.solution T hT).energy (LeanPML.Examples.WeakStaticMode.jet T hT) 0
            LeanPML.Examples.WeakStaticMode.initialY t =
          (LeanPML.Examples.WeakStaticMode.solution T hT).energy (LeanPML.Examples.WeakStaticMode.jet T hT) 0
            LeanPML.Examples.WeakStaticMode.initialY 0 ∧
        (LeanPML.Examples.WeakStaticMode.solution T hT).dissipation (LeanPML.Examples.WeakStaticMode.jet T hT) 0
            LeanPML.Examples.WeakStaticMode.initialY t =
          0 :=
fun T hT {t} ht =>
  ⟨LeanPML.Examples.WeakStaticMode.energy_pos T hT (Set.Ioo_subset_Icc_self ht),
    ⟨LeanPML.Examples.WeakStaticMode.energy_constant T hT t, LeanPML.Examples.WeakStaticMode.dissipation_zero T hT ht⟩⟩
theorem LeanPML.Examples.WeakBranchRegression.all_four_configurations : ∀ (T : ℝ) (hT : 0 ≤ T),
  (have C := (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration false false).spatial;
    let O :=
      LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T
        hT;
    O.EnergyConclusions
      (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T hT) 0
      0) ∧
    (have C := (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration true false).spatial;
      let O :=
        LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T
          hT;
      O.EnergyConclusions
        (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T hT)
        0 0) ∧
      (have C := (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration false true).spatial;
        let O :=
          LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1
            T hT;
        O.EnergyConclusions
          (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T
            hT)
          0 0) ∧
        have C := (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration true true).spatial;
        let O :=
          LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1
            T hT;
        O.EnergyConclusions
          (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T
            hT)
          0 0 :=
fun T hT =>
  ⟨LeanPML.Examples.WeakBranchRegression.configuration_main false false T hT,
    ⟨LeanPML.Examples.WeakBranchRegression.configuration_main true false T hT,
      ⟨LeanPML.Examples.WeakBranchRegression.configuration_main false true T hT,
        LeanPML.Examples.WeakBranchRegression.configuration_main true true T hT⟩⟩⟩
