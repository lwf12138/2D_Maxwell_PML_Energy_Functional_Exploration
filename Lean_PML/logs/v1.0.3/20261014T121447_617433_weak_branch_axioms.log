    fluxDDotX := fun x => 0, fluxDDotY := fun x => 0, electric_deriv := ⋯, flux_deriv := ⋯, electricDot_value := ⋯,
    electric_second := ⋯, polar_second := ⋯, flux_second_x := ⋯, flux_second_y := ⋯, continuous_electricDot := ⋯,
    continuous_fluxDot := ⋯, continuous_polarDot := ⋯, continuous_polarDDot := ⋯ }
theorem LeanPML.Examples.WeakBranchRegression.configuration_main : ∀ (xActive yActive : Bool) (T : ℝ) (hT : 0 ≤ T),
  have C := (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration xActive yActive).spatial;
  let O :=
    LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T hT;
  O.EnergyConclusions
    (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare C 1 1 1 1 T hT) 0
    0 :=
fun xActive yActive T hT =>
  id
    (have hphysical :=
      LeanPML.Examples.WeakBranchRegression.zero_initial_weighted LeanPML.Rectangle.ParameterCertificate.unitSquare
        (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration xActive yActive).spatial 1 1 1 1 T hT;
    LeanPML.PML.Weak.OriginalInterval.main_energy_estimate_WeakOriginal
      (LeanPML.Examples.WeakBranchRegression.zeroInterval LeanPML.Rectangle.ParameterCertificate.unitSquare
        (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration xActive yActive).spatial 1 1 1 1 T hT)
      (LeanPML.Examples.WeakBranchRegression.zeroJet LeanPML.Rectangle.ParameterCertificate.unitSquare
        (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration xActive yActive).spatial 1 1 1 1 T hT)
      0 0 (LeanPML.Examples.WeakBranchRegression.configuration_parameters xActive yActive) hphysical.left
      hphysical.right
      (LeanPML.Examples.WeakBranchRegression.zero_degenerate LeanPML.Rectangle.ParameterCertificate.unitSquare
        (LeanPML.PML.WeakRegionalAbsorption.certificateConfiguration xActive yActive).spatial 1 1 1 1 T hT))
