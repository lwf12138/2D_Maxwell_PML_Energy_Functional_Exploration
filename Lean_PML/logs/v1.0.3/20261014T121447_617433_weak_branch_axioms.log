def LeanPML.Examples.WeakBranchRegression.zeroInterval : (D : LeanPML.Rectangle.Rect) →
  (C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)) →
    (ε κ τ μ T : ℝ) → 0 ≤ T → LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T :=
fun D C ε κ τ μ T hT =>
  { nonneg_time := hT, fields := fun x => LeanPML.Examples.WeakBranchRegression.zeroOriginalState D,
    derivatives := fun x => LeanPML.Examples.WeakBranchRegression.zeroOriginalState D, electric := fun x => 0,
    flux := fun x => 0, u₀ := 0, q₀ := 0, continuous_fields := ⋯, continuous_electric := ⋯, continuous_flux := ⋯,
    electric_value := ⋯, flux_x := ⋯, flux_y := ⋯, equations := ⋯, initial_compatible := ⋯ }
def LeanPML.Examples.WeakBranchRegression.zeroJet : (D : LeanPML.Rectangle.Rect) →
  (C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)) →
    (ε κ τ μ T : ℝ) →
      (hT : 0 ≤ T) →
        LeanPML.PML.Weak.OriginalJet (LeanPML.Examples.WeakBranchRegression.zeroInterval D C ε κ τ μ T hT) :=
fun D C ε κ τ μ T hT =>
