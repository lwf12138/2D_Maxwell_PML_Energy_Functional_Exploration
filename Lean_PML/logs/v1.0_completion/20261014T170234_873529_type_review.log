  (ν : MeasureTheory.Measure α) (w m : α → ℝ) (hw : Measurable w) (hm : Measurable m) (C : ℝ)
  (hbound : ∀ (x : α), |m x| ≤ C) (t : ℝ) :
  LeanPML.Analysis.dampingKernel (LeanPML.Analysis.weightedMul ν w m hm C hbound) t =
    LeanPML.Analysis.scalarExpMultiplier ν w m hm C hbound t
