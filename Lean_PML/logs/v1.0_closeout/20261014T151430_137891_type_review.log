  {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε κ τ μ T : ℝ} (O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T)
  (J : LeanPML.PML.Weak.OriginalJet O) (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx))
  (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx))
  (hp : LeanPML.PML.CoercivityParameters C ε κ τ μ (LeanPML.Rectangle.poincareConstant D))
  (hWx : (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = O.φx 0)
  (hWy : (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = O.φy 0)
  (hdeg : LeanPML.PML.Weak.DegenerateJetCompatibility O J) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  O.OriginalAuxiliaryBounds (O.energy J W₀x W₀y 0) t
LeanPML.PML.Weak.V7TimeRegularity.fluxDot_eq {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ T : ℝ} {O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T} (R : LeanPML.PML.Weak.V7TimeRegularity O)
  {t : ℝ} (ht : t ∈ Set.Ioo 0 T) :
  ↑(R.fluxDot t) 0 =
      ↑↑(O.electric t) 1 +
        ((C.rCoeff.operator D.measure) (↑↑(O.u t) 1) - (C.pCoeff.operator D.measure) (↑(O.flux t) 0)) ∧
    ↑(R.fluxDot t) 1 =
      ↑↑(O.electric t) 2 +
        ((C.swap.rCoeff.operator D.measure) (↑↑(O.u t) 2) - (C.swap.pCoeff.operator D.measure) (↑(O.flux t) 1))
LeanPML.PML.Weak.V7TimeRegularity.flux_second {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ T : ℝ} {O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T} (R : LeanPML.PML.Weak.V7TimeRegularity O)
  {t : ℝ} (ht : t ∈ Set.Ioo 0 T) :
  HasDerivAt (fun s => ↑(R.fluxDot s) 0) (R.fluxDDotX t) t ∧ HasDerivAt (fun s => ↑(R.fluxDot s) 1) (R.fluxDDotY t) t
LeanPML.PML.Weak.V7TimeRegularity.toOriginalJet {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ T : ℝ} {O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T} (R : LeanPML.PML.Weak.V7TimeRegularity O) :
  LeanPML.PML.Weak.OriginalJet O
LeanPML.PML.Weak.V7TimeRegularity.main_energy_and_auxiliary {D : LeanPML.Rectangle.Rect}
  {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε κ τ μ T : ℝ} {O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T}
  (R : LeanPML.PML.Weak.V7TimeRegularity O) (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx))
  (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx))
  (hp : LeanPML.PML.CoercivityParameters C ε κ τ μ (LeanPML.Rectangle.poincareConstant D))
  (hWx : (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = O.φx 0)
  (hWy : (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = O.φy 0)
  (hdeg : LeanPML.PML.Weak.DegenerateJetCompatibility O R.toOriginalJet) :
  O.EnergyConclusions R.toOriginalJet W₀x W₀y ∧
    ∀ t ∈ Set.Icc 0 T, O.OriginalAuxiliaryBounds (O.energy R.toOriginalJet W₀x W₀y 0) t
LeanPML.PML.Weak.reverse_hasDerivAt {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε μ t : ℝ}
  {u e : ℝ → ↥(LeanPML.Rectangle.zeroBoundaryGraph D)} {L : ℝ → ↥(LeanPML.Rectangle.weakHDivGraph D)}
  {P q : ℝ → ↥(LeanPML.Analysis.ScalarL2 D.measure)} {Ldot : ↥(LeanPML.Rectangle.weakHDivGraph D)}
  {Edot Pdot : ↥(LeanPML.Analysis.ScalarL2 D.measure)} (hu : HasDerivAt u (e t) t)
  (he : HasDerivAt (fun s => ↑↑(e s) 0) Edot t) (hL : HasDerivAt L Ldot t) (hP : HasDerivAt P Pdot t)
  (hq : HasDerivAt q (P t) t) :
  LeanPML.PML.Weak.OriginalHasDerivAt (LeanPML.PML.Weak.reverseFields D C ε μ u e L P q)
    (LeanPML.PML.Weak.reverseDerivatives D C ε μ (e t) Ldot (P t) Edot Pdot) t
LeanPML.PML.Weak.primitive_to_original_WeakAt {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ t : ℝ} {u e : ℝ → ↥(LeanPML.Rectangle.zeroBoundaryGraph D)} {L : ℝ → ↥(LeanPML.Rectangle.weakHDivGraph D)}
  {P q : ℝ → ↥(LeanPML.Analysis.ScalarL2 D.measure)} {Ldot : ↥(LeanPML.Rectangle.weakHDivGraph D)}
  {Edot Pdot : ↥(LeanPML.Analysis.ScalarL2 D.measure)} (hμ : μ ≠ 0) (hu : HasDerivAt u (e t) t)
  (he : HasDerivAt (fun s => ↑↑(e s) 0) Edot t) (hL : HasDerivAt L Ldot t) (hP : HasDerivAt P Pdot t)
  (hq : HasDerivAt q (P t) t) (hpolar : ∀ᶠ (s : ℝ) in nhds t, q s + τ • P s = κ • ↑↑(u s) 0)
  (hx :
    HasDerivAt (fun s => ↑(L s) 0 - ↑↑(u s) 1)
      ((C.rCoeff.operator D.measure) (↑↑(u t) 1) - (C.pCoeff.operator D.measure) (↑(L t) 0)) t)
  (hy :
    HasDerivAt (fun s => ↑(L s) 1 - ↑↑(u s) 2)
      ((C.pCoeff.operator D.measure) (↑↑(u t) 2) - (C.rCoeff.operator D.measure) (↑(L t) 1)) t)
  (hmain :
    μ •
        (ε • (Edot + (C.aCoeff.operator D.measure) (↑↑(e t) 0) + (C.bCoeff.operator D.measure) (↑↑(u t) 0)) + Pdot +
            (C.aCoeff.operator D.measure) (P t) +
          (C.bCoeff.operator D.measure) (q t)) =
      ↑(L t) 2) :
  LeanPML.PML.Weak.OriginalAt D C ε κ τ μ (LeanPML.PML.Weak.reverseFields D C ε μ u e L P q)
    (LeanPML.PML.Weak.reverseDerivatives D C ε μ (e t) Ldot (P t) Edot Pdot) t (e t) (L t)
LeanPML.PML.Weak.primitive_to_original_WeakOn {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ T : ℝ} (Q : LeanPML.PML.Weak.PrimitiveIntervalData D C ε κ τ μ T) (hμ : μ ≠ 0) (t : ℝ) :
  t ∈ Set.Ioo 0 T →
    LeanPML.PML.Weak.OriginalAt D C ε κ τ μ (LeanPML.PML.Weak.reverseFields D C ε μ Q.u Q.e Q.flux Q.P Q.q)
      (LeanPML.PML.Weak.reverseDerivatives D C ε μ (Q.e t) (Q.fluxDot t) (Q.P t) (Q.Edot t) (Q.Pdot t)) t (Q.e t)
      (Q.flux t)
LeanPML.PML.Weak.reverse_compatible {D : LeanPML.Rectangle.Rect} {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)}
  {ε κ τ μ T : ℝ} (Q : LeanPML.PML.Weak.PrimitiveIntervalData D C ε κ τ μ T) (hμ : μ ≠ 0) {t : ℝ}
  (ht : t ∈ Set.Icc 0 T) :
  LeanPML.PML.Weak.invariants D C ε κ τ μ (LeanPML.PML.Weak.reverseFields D C ε μ Q.u Q.e Q.flux Q.P Q.q) Q.u Q.q t = 0
LeanPML.Analysis.operator_memory_formula.{u_1} {H : Type u_1} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]
  (B : H →L[ℝ] H) (W F : ℝ → H) {T t : ℝ} (hW : ContinuousOn W (Set.Icc 0 T)) (hF : ContinuousOn F (Set.Icc 0 T))
  (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt W (-B (W s) + F s) s) (ht : t ∈ Set.Icc 0 T) :
  IntervalIntegrable (fun s => (NormedSpace.exp ((s - t) • B)) (F s)) MeasureTheory.volume 0 t ∧
    W t = (NormedSpace.exp (-t • B)) (W 0) + ∫ (s : ℝ) in 0..t, (NormedSpace.exp ((s - t) • B)) (F s)
LeanPML.PML.SpatialAbsorption.auxiliary_operator_memory.{u_1} {α : Type u_1} [MeasurableSpace α] [Nonempty α]
  (ν : MeasureTheory.Measure α) (C : LeanPML.PML.SpatialAbsorption α) (W₀ : ↥(LeanPML.Analysis.WeightedL2 ν C.wx))
  (φ h l : ℝ → ↥(LeanPML.Analysis.ScalarL2 ν)) (T : ℝ) (hφ : ContinuousOn φ (Set.Icc 0 T))
  (hh : ContinuousOn h (Set.Icc 0 T)) (hl : ContinuousOn l (Set.Icc 0 T))
  (hinitial : (LeanPML.Analysis.physicalL2 ν C.wx ⋯ ⋯) W₀ = φ 0)
  (hODE : ∀ s ∈ Set.Ioo 0 T, HasDerivAt φ ((C.rCoeff.operator ν) (h s) - (C.pCoeff.operator ν) (l s)) s)
  (hspace : ∀ s ∈ Set.Icc 0 T, l s = h s + φ s) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  IntervalIntegrable
      (fun s =>
        (LeanPML.Analysis.dampingKernel (LeanPML.PML.SpatialAbsorption.dampingOperator ν C) (s - t))
          ((LeanPML.PML.SpatialAbsorption.differenceLift ν C) (h s)))
      MeasureTheory.volume 0 t ∧
    LeanPML.PML.SpatialAbsorption.auxiliaryWeightedHistory ν C W₀ h l t =
      (LeanPML.Analysis.dampingKernel (LeanPML.PML.SpatialAbsorption.dampingOperator ν C) (-t)) W₀ +
        ∫ (s : ℝ) in 0..t,
          (LeanPML.Analysis.dampingKernel (LeanPML.PML.SpatialAbsorption.dampingOperator ν C) (s - t))
            ((LeanPML.PML.SpatialAbsorption.differenceLift ν C) (h s))
LeanPML.PML.Weak.OriginalInterval.operator_memory_both {D : LeanPML.Rectangle.Rect}
  {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε κ τ μ T : ℝ} (O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T)
  (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx)) (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx))
  (hWx : (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = O.φx 0)
  (hWy : (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = O.φy 0) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  O.weightedX W₀x t = LeanPML.PML.SpatialAbsorption.exponentialHistory D.measure C W₀x (fun s => ↑↑(O.u s) 1) t ∧
    O.weightedY W₀y t =
      (LeanPML.PML.Weak.weightedCongr D.measure ⋯)
        (LeanPML.PML.SpatialAbsorption.exponentialHistory D.measure C.swap W₀y (fun s => ↑↑(O.u s) 2) t)
LeanPML.Examples.WeakStaticMode.closeout_main_call (T : ℝ) (hT : 0 ≤ T) :
  (LeanPML.Examples.WeakStaticMode.solution T hT).EnergyConclusions
      (LeanPML.Examples.WeakStaticMode.timeRegularity T hT).toOriginalJet 0 LeanPML.Examples.WeakStaticMode.initialY ∧
    ∀ t ∈ Set.Icc 0 T,
      (LeanPML.Examples.WeakStaticMode.solution T hT).OriginalAuxiliaryBounds
        ((LeanPML.Examples.WeakStaticMode.solution T hT).energy
          (LeanPML.Examples.WeakStaticMode.timeRegularity T hT).toOriginalJet 0 LeanPML.Examples.WeakStaticMode.initialY
          0)
        t
LeanPML.Examples.WeakStaticMode.reverse_static_call (T : ℝ) {t : ℝ} (ht : t ∈ Set.Ioo 0 T) :
  LeanPML.PML.Weak.OriginalAt LeanPML.Rectangle.ParameterCertificate.unitSquare
    LeanPML.Examples.WeakStaticMode.coefficients 1 1 1 1
    (LeanPML.PML.Weak.reverseFields LeanPML.Rectangle.ParameterCertificate.unitSquare
      LeanPML.Examples.WeakStaticMode.coefficients 1 1 (LeanPML.Examples.WeakStaticMode.primitiveData T).u
      (LeanPML.Examples.WeakStaticMode.primitiveData T).e (LeanPML.Examples.WeakStaticMode.primitiveData T).flux
      (LeanPML.Examples.WeakStaticMode.primitiveData T).P (LeanPML.Examples.WeakStaticMode.primitiveData T).q)
    (LeanPML.PML.Weak.reverseDerivatives LeanPML.Rectangle.ParameterCertificate.unitSquare
      LeanPML.Examples.WeakStaticMode.coefficients 1 1 ((LeanPML.Examples.WeakStaticMode.primitiveData T).e t)
      ((LeanPML.Examples.WeakStaticMode.primitiveData T).fluxDot t)
      ((LeanPML.Examples.WeakStaticMode.primitiveData T).P t) ((LeanPML.Examples.WeakStaticMode.primitiveData T).Edot t)
      ((LeanPML.Examples.WeakStaticMode.primitiveData T).Pdot t))
    t ((LeanPML.Examples.WeakStaticMode.primitiveData T).e t) ((LeanPML.Examples.WeakStaticMode.primitiveData T).flux t)
LeanPML.Examples.WeakStaticMode.kernel_static_call (T : ℝ) (hT : 0 ≤ T) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  (LeanPML.Examples.WeakStaticMode.solution T hT).weightedX 0 t =
      LeanPML.PML.SpatialAbsorption.exponentialHistory LeanPML.Rectangle.ParameterCertificate.unitSquare.measure
        LeanPML.Examples.WeakStaticMode.coefficients 0
        (fun s => ↑↑((LeanPML.Examples.WeakStaticMode.solution T hT).u s) 1) t ∧
    (LeanPML.Examples.WeakStaticMode.solution T hT).weightedY LeanPML.Examples.WeakStaticMode.initialY t =
      (LeanPML.PML.Weak.weightedCongr LeanPML.Rectangle.ParameterCertificate.unitSquare.measure ⋯)
        (LeanPML.PML.SpatialAbsorption.exponentialHistory LeanPML.Rectangle.ParameterCertificate.unitSquare.measure
          LeanPML.Examples.WeakStaticMode.coefficients.swap LeanPML.Examples.WeakStaticMode.initialY
          (fun s => ↑↑((LeanPML.Examples.WeakStaticMode.solution T hT).u s) 2) t)
HasDerivAt.scomp.{u, v, u_1} {𝕜 : Type u} [NontriviallyNormedField 𝕜] {F : Type v} [NormedAddCommGroup F]
  [NormedSpace 𝕜 F] (x : 𝕜) {𝕜' : Type u_1} [NontriviallyNormedField 𝕜'] [NormedAlgebra 𝕜 𝕜'] [NormedSpace 𝕜' F]
  [IsScalarTower 𝕜 𝕜' F] {h : 𝕜 → 𝕜'} {h' : 𝕜'} {g₁ : 𝕜' → F} {g₁' : F} (hg : HasDerivAt g₁ g₁' (h x))
  (hh : HasDerivAt h h' x) : HasDerivAt (g₁ ∘ h) (h' • g₁') x
hasDerivAt_exp_smul_const.{u_1, u_3} {𝕂 : Type u_1} {𝔸 : Type u_3} [RCLike 𝕂] [NormedRing 𝔸] [NormedAlgebra 𝕂 𝔸]
  [CompleteSpace 𝔸] (x : 𝔸) (t : 𝕂) : HasDerivAt (fun u => NormedSpace.exp (u • x)) (NormedSpace.exp (t • x) * x) t
HasDerivAt.clm_apply.{u, v, u_2} {𝕜 : Type u} [NontriviallyNormedField 𝕜] {F : Type v} [NormedAddCommGroup F]
  [NormedSpace 𝕜 F] {x : 𝕜} {G : Type u_2} [NormedAddCommGroup G] [NormedSpace 𝕜 G] {c : 𝕜 → F →L[𝕜] G} {c' : F →L[𝕜] G}
  {u : 𝕜 → F} {u' : F} (hc : HasDerivAt c c' x) (hu : HasDerivAt u u' x) :
  HasDerivAt (fun y => (c y) (u y)) (c' (u x) + (c x) u') x
intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le.{u_3} {E : Type u_3} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {a b : ℝ} [CompleteSpace E] {f f' : ℝ → E} (hab : a ≤ b) (hcont : ContinuousOn f (Set.Icc a b))
  (hderiv : ∀ x ∈ Set.Ioo a b, HasDerivAt f (f' x) x) (hint : IntervalIntegrable f' MeasureTheory.volume a b) :
  ∫ (y : ℝ) in a..b, f' y = f b - f a
