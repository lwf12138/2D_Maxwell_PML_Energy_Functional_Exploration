LeanPML.PML.Weak.OriginalInterval.auxiliary_reconstruction {D : LeanPML.Rectangle.Rect}
  {C : LeanPML.PML.SpatialAbsorption (ℝ × ℝ)} {ε κ τ μ T : ℝ} (O : LeanPML.PML.Weak.OriginalInterval D C ε κ τ μ T)
  (W₀x : ↥(LeanPML.Analysis.WeightedL2 D.measure C.wx)) (W₀y : ↥(LeanPML.Analysis.WeightedL2 D.measure C.swap.wx))
  (hWx : (LeanPML.Analysis.physicalL2 D.measure C.wx ⋯ ⋯) W₀x = O.φx 0)
  (hWy : (LeanPML.Analysis.physicalL2 D.measure C.swap.wx ⋯ ⋯) W₀y = O.φy 0) {t : ℝ} (ht : t ∈ Set.Icc 0 T) :
  LeanPML.PML.reconstructQ κ τ (O.baseState W₀x W₀y t) = O.q t ∧
    LeanPML.PML.reconstructZ1 D.measure C ε (O.baseState W₀x W₀y t) = (O.fields t).Z1 ∧
      LeanPML.PML.reconstructZ2 D.measure C κ τ (O.baseState W₀x W₀y t) = (O.fields t).Z2 ∧
        LeanPML.PML.reconstructAuxX D.measure C (O.baseState W₀x W₀y t) = (O.fields t).Qx ∧
          LeanPML.PML.reconstructAuxY D.measure C (O.baseState W₀x W₀y t) = (O.fields t).Qy
