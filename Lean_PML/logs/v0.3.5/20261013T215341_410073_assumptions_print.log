LeanPML.PML.gradient_control_Conditional.{u_1, u_2} {α : Type u_1} [MeasurableSpace α] {ν : MeasureTheory.Measure α}
  {Boundary : Type u_2} [AddCommGroup Boundary] [Module ℝ Boundary] {G : LeanPML.PML.ConditionalGreenDomain ν Boundary}
  {C : LeanPML.PML.SpatialAbsorption α} {I : Set ℝ} (ε κ τ μ : ℝ) (path : LeanPML.PML.SameSourcePath ν C.wx C.wy I)
  (regular : LeanPML.PML.ConditionalSpatialPath G C path)
  (hbase :
    ∀ s ∈ I,
      LeanPML.PML.PrimitiveAtConditional G C ε κ τ μ (path.base s) (path.first s) (regular.base_v s)
        (regular.base_flux s))
  {t : ℝ} (ht : t ∈ interior I) :
  ‖G.spatial.componentX (regular.first_v t)‖ ^ 2 + ‖G.spatial.componentY (regular.first_v t)‖ ^ 2 ≤
    3 * LeanPML.PML.fieldJ ν C (path.first t) + 3 * C.S ^ 2 * LeanPML.PML.fieldJ ν C (path.base t)
LeanPML.PML.dissipation7_lower_Conditional.{u_1, u_2} {α : Type u_1} [MeasurableSpace α] [Nonempty α]
  {ν : MeasureTheory.Measure α} {Boundary : Type u_2} [AddCommGroup Boundary] [Module ℝ Boundary]
  (G : LeanPML.PML.ConditionalGreenDomain ν Boundary) (C : LeanPML.PML.SpatialAbsorption α) (ε κ τ μ CP : ℝ)
  (hp : LeanPML.PML.CoercivityParameters C ε κ τ μ CP)
  (estimate :
    ∀ (f : ↥G.spatial.domain),
      G.trace f = 0 → ‖↑f‖ ^ 2 ≤ CP ^ 2 * (‖G.spatial.componentX f‖ ^ 2 + ‖G.spatial.componentY f‖ ^ 2))
  {I : Set ℝ} (path : LeanPML.PML.SameSourcePath ν C.wx C.wy I) (regular : LeanPML.PML.ConditionalSpatialPath G C path)
  (hbase :
    ∀ s ∈ I,
      LeanPML.PML.PrimitiveAtConditional G C ε κ τ μ (path.base s) (path.first s) (regular.base_v s)
        (regular.base_flux s))
  {t : ℝ} (ht : t ∈ interior I) :
  (LeanPML.PML.fieldSpatialDissipation ν C (path.base t) +
          LeanPML.PML.scaleK ε κ μ CP * LeanPML.PML.fieldSpatialDissipation ν C (path.first t)) /
        2 +
      μ * τ / (4 * κ) * (‖(path.first t).R‖ ^ 2 + LeanPML.PML.scaleK ε κ μ CP * ‖(path.second t).R‖ ^ 2) ≤
    LeanPML.PML.dissipation7 ν C ε κ τ μ CP path t
LeanPML.PML.main_energy_estimate_Conditional.{u_1, u_2} {α : Type u_1} [MeasurableSpace α] {ν : MeasureTheory.Measure α}
  {Boundary : Type u_2} [AddCommGroup Boundary] [Module ℝ Boundary] (G : LeanPML.PML.ConditionalGreenDomain ν Boundary)
  (C : LeanPML.PML.SpatialAbsorption α) (ε κ τ μ CP T : ℝ) (hp : LeanPML.PML.CoercivityParameters C ε κ τ μ CP)
  (estimate :
    ∀ (f : ↥G.spatial.domain),
      G.trace f = 0 → ‖↑f‖ ^ 2 ≤ CP ^ 2 * (‖G.spatial.componentX f‖ ^ 2 + ‖G.spatial.componentY f‖ ^ 2))
  (problem : LeanPML.PML.FiniteIntervalProblemConditional G C ε κ τ μ CP T estimate) [Nonempty α]
  (hsecondR : ContinuousOn (fun t => (problem.path.second t).R) (Set.Icc 0 T)) :
  AntitoneOn (LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path) (Set.Icc 0 T) ∧
    (∀ t ∈ Set.Ioo 0 T,
        HasDerivAt (LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path)
            (-LeanPML.PML.dissipation7 ν C ε κ τ μ CP problem.path t) t ∧
          (LeanPML.PML.fieldSpatialDissipation ν C (problem.path.base t) +
                    LeanPML.PML.scaleK ε κ μ CP * LeanPML.PML.fieldSpatialDissipation ν C (problem.path.first t)) /
                  2 +
                μ * τ / (4 * κ) *
                  (‖(problem.path.first t).R‖ ^ 2 + LeanPML.PML.scaleK ε κ μ CP * ‖(problem.path.second t).R‖ ^ 2) ≤
              LeanPML.PML.dissipation7 ν C ε κ τ μ CP problem.path t ∧
            0 ≤ LeanPML.PML.dissipation7 ν C ε κ τ μ CP problem.path t) ∧
      (∀ t ∈ Set.Icc 0 T,
          (LeanPML.PML.graphSquare7 ν C ε κ μ CP problem.path t / 4 ≤
                LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t ∧
              LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t ≤
                LeanPML.PML.graphSquare7 ν C ε κ μ CP problem.path t) ∧
            (0 ≤ LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t ∧
                LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t ≤ LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path 0) ∧
              LeanPML.PML.graphSquare7 ν C ε κ μ CP problem.path t ≤
                  4 * LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path 0 ∧
                LeanPML.PML.PhysicalInitialControlBounds ν C ε κ τ μ CP problem.path t) ∧
        ∀ (t₁ t₂ : ℝ),
          0 ≤ t₁ →
            t₁ ≤ t₂ →
              t₂ ≤ T →
                LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t₂ +
                    ∫ (t : ℝ) in t₁..t₂, LeanPML.PML.dissipation7 ν C ε κ τ μ CP problem.path t =
                  LeanPML.PML.energy7 ν C ε κ τ μ CP problem.path t₁
