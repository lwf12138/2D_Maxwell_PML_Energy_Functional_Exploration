    (div_base : ∀ t ∈ interior I, HasDerivAt (fun s => G.divergence (base_flux s)) (G.divergence (first_flux t)) t)
    (trace_base_v : ∀ t ∈ I, G.trace (base_v t) = 0) (trace_base_V : ∀ t ∈ I, G.trace (base_V t) = 0)
