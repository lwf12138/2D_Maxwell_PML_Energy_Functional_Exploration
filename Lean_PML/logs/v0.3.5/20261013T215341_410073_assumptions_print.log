    (base_V_eq : ∀ t ∈ I, ↑(base_V t) = (path.base t).V) (first_v_eq : ∀ t ∈ I, ↑(first_v t) = (path.first t).v)
    (first_V_eq : ∀ t ∈ I, ↑(first_V t) = (path.first t).V)
    (base_flux_eq : ∀ t ∈ I, ↑(base_flux t) = ((path.base t).Λx, (path.base t).Λy))
    (first_flux_eq : ∀ t ∈ I, ↑(first_flux t) = ((path.first t).Λx, (path.first t).Λy))
    (grad_baseX :
