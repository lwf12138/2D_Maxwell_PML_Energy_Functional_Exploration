  ---
  fact_id: fact:2d_maxwell_pml_energy_functional_exploration:stretched-coordinate-debye-pml-matching-and-energy-gap
  problem_id: 2d_maxwell_pml_energy_functional_exploration
  source_project: 2d_maxwell_pml_energy_functional_exploration
  source_task: task-stage3-repaired-model-energy
