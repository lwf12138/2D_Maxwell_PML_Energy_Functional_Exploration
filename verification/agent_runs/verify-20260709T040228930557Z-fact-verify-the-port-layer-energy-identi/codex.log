     260	
     261	\section{正定性、非负耗散与失败机制}
     262	
     263	\subsection{Debye primitive 二次型}
     264	
     265	\[
     266	M_{Pq}=\begin{pmatrix}\alpha&\beta\\ \beta&\gamma\end{pmatrix}.
     267	\]
     268	其行列式为
     269	\[
     270	\alpha\gamma-\beta^2
     271	=b+ab\tau+2a^3\tau+b(2a^2-b)\tau^2.
     272	\]
     273	在 \(\sx,\sy\ge0\) 时
     274	\[
     275	2a^2-b=2\sx^2+3\sx\sy+2\sy^2\ge0,
     276	\]
     277	故在 \(a>0\)、\(\tau>0\) 且角 PML 中 \(b>0\) 时该块正定。边 PML 中 \(b=0\)
     278	时 primitive 变量的若干方向退化，必须单独处理。
     279	
     280	\subsection{理想耗散非负条件}
     281	
     282	\[
     283	\Gamma_1(I+a^{-1}\Gamma_1)
     284	=\diag\left(\sx\left(1+\frac{\sx}{a}\right),
     285	\sy\left(1+\frac{\sy}{a}\right)\right)\ge0,
     286	\]
     287	\[
     288	\frac{b}{a}\ge0,\qquad a^2-b=\sx^2+\sx\sy+\sy^2\ge0,\qquad ab\ge0.
     289	\]
     290	所以在 \(a>0\)、\(\sx,\sy\ge0\)、材料参数正的区域中 \(D_0\ge0\)。若要把
     291	\(R_\sigma\) 吸收到 \(D_0\)，还需要 \(D_0\) 对 \(\|u\|\) 与 \(\|\lambda\|\) 有正
     292	下界；这通常要求角 PML 中 \(\sx,\sy\) 有正下界。边 PML 或物理区不满足该条件。
     293	
     294	\subsection{变量系数余项符号不定}
     295	
     296	即使 \(\sx',\sy'\ge0\)，也不能推出 \(R_\sigma\le0\)。例如在一个开集上
     297	\(\sx'>0\)、\(\sy'=0\)。若取 \(u\ge0\) 且 \(\lambda_x<0\)，则
     298	\[
     299	-u\sx'\lambda_x>0,
     300	\]
     301	使 \(R_\sigma\) 对能量导数作正贡献；若 \(\lambda_x>0\)，该项才为负。变量
     302	\(\lambda\) 是动态未知量，其符号不由阻尼剖面的单调性决定。因此 ``阻尼递增''
     303	不是单调能量证明。
     304	
     305	\section{小梯度吸收定理}
     306	
     307	设在角 PML 子区域 \(\Omega_c\) 中边界通量非正，并有常数 \(m_u,m_\lambda>0\)
     308	使
     309	\[
     310	D_0(t)\ge m_u\|u\|_{L^2(\Omega_c)}^2
     311	+m_\lambda\|\lambda\|_{L^2(\Omega_c)}^2+\hbox{其他非负项}.
     312	\]
     313	令 \(g=\|\nabla a\|_{L^\infty(\Omega_c)}\)。由 Cauchy--Schwarz，
     314	\[
     315	|R_\sigma(t)|\le g\|u\|\,\|\lambda\|.
     316	\]
     317	二维二次型
     318	\[
     319	-m_u u^2-m_\lambda\lambda^2+g u\lambda
     320	\]
     321	半负定当且仅当
     322	\[
     323	g^2\le4m_um_\lambda.
     324	\]
     325	更强地，若
     326	\begin{equation}
     327	\boxed{\|\nabla a\|_{L^\infty(\Omega_c)}^2<4m_um_\lambda,}
     328	\label{eq:small-gradient}
     329	\end{equation}
     330	取
     331	\[
     332	\theta=1-\frac{\|\nabla a\|_{L^\infty}}{2\sqrt{m_um_\lambda}}>0,
     333	\]
     334	则
     335	\[
     336	|R_\sigma(t)|\le(1-\theta)D_0(t),
     337	\]
     338	从而由 \eqref{eq:variable-identity} 得
     339	\[
     340	\boxed{\frac{\dd}{\dd t}\Ecal_B(t)+\theta D_0(t)\le0.}
     341	\]
     342	这是可写入论文的变量系数 stretched-coordinate theorem，但它是有条件结论：
     343	需要角 PML 正下界、耗散控制 \(u,\lambda\)、小梯度和非正通量。若缺少这些条件，只能得
     344	\[
     345	\Ecal_B'(t)\le C_\sigma\Ecal_B(t),
     346	\]
     347	即 Gronwall 有界性，不是单调下降。
     348	
     349	\section{Port 模型能量与匹配性分离验证}
     350	
     351	新 PDF 的 port 模型为
     352	\begin{align}
     353	\eps E_t+P_t+\eps\sigma_E E&=\partial_xW_y-\partial_yW_x,\label{eq:port-E}\\
     354	\mu W_{x,t}+\mu\sy W_x&=-\partial_yE,\label{eq:port-Wx}\\
     355	\mu W_{y,t}+\mu\sx W_y&=\partial_xE,\label{eq:port-Wy}\\
     356	\tau P_t+P&=\kappa E.\label{eq:port-P}
     357	\end{align}
     358	若 \(\sx=\sy=\sigma_E=0\)，并识别 \(W_x=H_x,W_y=H_y\)，则
     359	\eqref{eq:port-E}--\eqref{eq:port-P} 退化为物理 Maxwell--Debye 系统。
     360	
     361	\subsection{端口能量}
     362	
     363	定义
     364	\[
     365	\Ecal_{\rm port}(t)=\frac12\int_\Omega
     366	\left(\eps E^2+\mu W_x^2+\mu W_y^2+\kappa^{-1}P^2\right)\dd x\dd y.
     367	\]
     368	将 \eqref{eq:port-E}--\eqref{eq:port-Wy} 分别乘以 \(E,W_x,W_y\)，空间项满足
     369	\[
     370	E(\partial_xW_y-\partial_yW_x)-W_x\partial_yE+W_y\partial_xE
     371	=\partial_x(EW_y)-\partial_y(EW_x).
     372	\]
     373	并且
     374	\[
     375	EP_t=\frac1{2\kappa}\partial_t(P^2)+\frac{\tau}{\kappa}P_t^2.
     376	\]
     377	因此
     378	\[
     379	\boxed{
     380	\frac{\dd}{\dd t}\Ecal_{\rm port}(t)
     381	+\int_\Omega\left(
     382	\eps\sigma_EE^2+\mu\sy W_x^2+\mu\sx W_y^2+\frac{\tau}{\kappa}P_t^2
     383	\right)\dd x\dd y
     384	=\int_{\partial\Omega}E(W_y n_x-W_xn_y)\dd s.}
     385	\]
     386	在 PEC、周期或非正端口通量边界下，这是无条件单调能量。
     387	
     388	\subsection{平面界面阻抗测试}
     389	
     390	考虑 \(x\)-PML，
     391	\[
     392	\sx=\sigma>0,\qquad \sy=0,
     393	\]
     394	并取 Laplace--Fourier 模态 \(e^{st+ik_y y+\nu x}\)、\(\Re s>0\)。物理介质中
     395	\[
     396	\eps_D(s)=\eps+\frac{\kappa}{1+\tau s},\qquad
     397	Y_0=\frac{H_y}{E}=\frac{\nu_0}{\mu s},\qquad
     398	\nu_0^2=k_y^2+\mu s^2\eps_D(s).
     399	\]
     400	Port 模型的代数系统为
     401	\[
     402	(s\eps_D(s)+\eps\sigma_E)E=\nu W_y-ik_yW_x,
     403	\]
     404	\[
     405	\mu sW_x=-ik_yE,\qquad \mu(s+\sigma)W_y=\nu E.
     406	\]
     407	故
     408	\[
     409	\frac{W_y}{E}=\frac{\nu}{\mu(s+\sigma)}
     410	\]
     411	且
     412	\[
     413	Y_{\rm port}^2
     414	=\frac{s\eps_D(s)+\eps\sigma_E}{\mu(s+\sigma)}
     415	+\frac{k_y^2}{\mu^2s(s+\sigma)}.
     416	\]
     417	与
     418	\[
     419	Y_0^2=\frac{\eps_D(s)}{\mu}+\frac{k_y^2}{\mu^2s^2}
     420	\]
     421	相减得
     422	\begin{equation}
     423	\boxed{
     424	Y_{\rm port}^2-Y_0^2
     425	=\frac{\eps\sigma_E-\sigma\eps_D(s)}{\mu(s+\sigma)}
     426	-\frac{\sigma k_y^2}{\mu^2s^2(s+\sigma)}.}
     427	\label{eq:port-mismatch}
     428	\end{equation}
     429	反射系数为
     430	\[
     431	R_{\rm port}=\frac{Y_0-Y_{\rm port}}{Y_0+Y_{\rm port}}.
     432	\]
     433	若要 \eqref{eq:port-mismatch} 对所有 \(k_y\) 为零，第二项强迫
     434	\(\sigma k_y^2=0\)。因此只要 \(\sigma>0\) 且存在斜入射 \(k_y\ne0\)，
     435	port 模型一般不 perfectly matched。
     436	
     437	法向入射 \(k_y=0\) 时，可令
     438	\[
     439	\sigma_E(s)=\sigma\frac{\eps_D(s)}{\eps}
     440	\]
     441	使 \(Y_{\rm port}=Y_0\)。但该选择通常是频率依赖的 Debye 卷积阻尼；并且即使用它，
     442	斜入射残差仍为
     443	\[
     444	-\frac{\sigma k_y^2}{\mu^2s^2(s+\sigma)}.
     445	\]
     446	所以 port 模型应称为 stable absorbing layer，而不是 strict PML。
     447	
     448	\section{形式化验证结果}
     449	
     450	本轮创建了
     451	\[
     452	\texttt{verification/algebra/VariableCoefficientBaffet.lean}
     453	\]
     454	和
     455	\[
     456	\texttt{verification/algebra/variable\_coefficient\_baffet\_sympy.py}.
     457	\]
     458	SymPy 检查覆盖 Debye primitive 恒等式、\(P,q\) 行列式、
     459	\(2a^2-b\) 展开、变量乘子梯度项、小梯度 Schur 补、port 能量交叉项抵消、strict
     460	stretched-coordinate admittance，以及 port 模型阻抗失配公式。命令
     461	\[
     462	\texttt{python3 verification/algebra/variable\_coefficient\_baffet\_sympy.py}
     463	\]
     464	已通过。
     465	
     466	Lean 文件覆盖同一组核心代数中的五个 Lean 目标：Debye primitive 乘积、\(P,q\)
     467	行列式、\(2a^2-b\) 展开、变量系数乘子的一维 product-rule 版本、以及
     468	\[
     469	-m_u u^2-m_\lambda\lambda^2+g u\lambda\le0
     470	\]
     471	的吸收判据。本机实际运行
     472	\[
     473	\texttt{lean verification/algebra/VariableCoefficientBaffet.lean}
     474	\]
     475	失败，原因是当前环境没有 \(\texttt{lean}\) 可执行文件：
     476	\[
     477	\texttt{zsh:1: command not found: lean}.
     478	\]
     479	
     480	\section{下一步论文 theorem 推荐形式}
     481	
     482	建议把论文主线拆成三个定理，避免把 Gronwall 或 port 稳定性误写成 strict PML
     483	单调能量。
     484	
     485	\begin{theorem}[平面界面 perfect matching]
     486	对 strict stretched-coordinate Maxwell--Debye PML，保持
     487	\((1+\tau s)\widehat P=\kappa\widehat E\) 并只拉伸空间导数，则常系数平面界面满足
     488	\(\nu_+=S_x\nu_0\)、\(Y_+=Y_0\)，故 \(R=0\)。
     489	\end{theorem}
     490	
     491	\begin{theorem}[变系数 Baffet 小梯度单调性]
     492	在角 PML 区域 \(\Omega_c\) 中，若 \(\sx,\sy\) 有正下界、边界通量非正、
     493	\(D_0\ge m_u\|u\|^2+m_\lambda\|\lambda\|^2+\cdots\)，且
     494	\(\|\nabla a\|_{L^\infty}^2<4m_um_\lambda\)，则 \eqref{eq:EB} 满足
     495	\[
     496	\frac{\dd}{\dd t}\Ecal_B(t)+\theta D_0(t)\le0,\qquad \theta>0.
     497	\]
     498	若没有小梯度条件，不应声称单调下降。
     499	\end{theorem}
     500	
     501	\begin{theorem}[Port absorbing layer]
     502	Port 模型 \eqref{eq:port-E}--\eqref{eq:port-P} 对任意非负
     503	\(\sx,\sy,\sigma_E\) 有正的端口能量耗散恒等式。但由
     504	\eqref{eq:port-mismatch}，它对斜入射一般 \(R_{\rm port}\ne0\)，因此是 stable
     505	absorbing layer，不是 strict PML。
     506	\end{theorem}
     507	
     508	\end{document}

