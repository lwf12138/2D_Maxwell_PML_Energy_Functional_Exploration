     230	\[
     231	 C_\lambda=\Gamma_1(I+a^{-1}\Gamma_1),\qquad c_u=\mu\ep ab,
     232	\quad Q=\begin{pmatrix}c_u&(\nabla a)^T/2\\ \nabla a/2&C_\lambda\end{pmatrix}.
     233	\]
     234	\begin{theorem}[Level-B 条件单调性]\label{thm:levelb}
     235	设角域上 $\sx,\sy$ 有正上下界，解相容，$\mathcal B\le0$，且存在
     236	$\delta\in(0,1)$ 使
     237	\begin{equation}\label{eq:schur}
     238	 (\nabla a)^TC_\lambda^{-1}\nabla a\le4(1-\delta)c_u
     239	 \quad\text{a.e.}
     240	\end{equation}
     241	则存在 $\theta>0$ 使
     242	\[
     243	 \E_B'(t)+\theta\D_0(t)\le0.
     244	\]
     245	\end{theorem}
     246	\begin{proof}
     247	矩阵 $Q$ 的 Schur 补正是
     248	$c_u-\frac14(\nabla a)^TC_\lambda^{-1}\nabla a$。
     249	条件 \eqref{eq:schur} 以统一余量吸收
     250	$|u\nabla a\cdot\lambda|$，其余 \eqref{eq:D0} 项不变。代入
     251	\eqref{eq:id} 并用 $\mathcal B\le0$ 即得。等价的积分充分条件为
     252	$\D_0\ge m_u\|u\|^2+m_\lambda\|\lambda\|^2+\cdots$ 与
     253	$\|\nabla a\|_\infty^2<4m_um_\lambda$。
     254	\end{proof}
     255	
     256	若无 \eqref{eq:schur}，只能由能量控制得到 $\E_B'\le C_\sigma\E_B$；这是
     257	Gronwall 估计，不是单调性。冻结块 $m_u=m_\lambda=1$、$|\nabla a|=3$ 的
     258	Schur 矩阵特征值为 $-1/2,5/2$，精确展示高梯度失败。
     259	
     260	\section{椭圆非局部修正的完整动态审查}
     261	
     262	\begin{definition}[椭圆变量]
     263	令 $\Om_+$ 为 Lipschitz 角 PML 子域，$V=H_0^1(\Om_+)$，
     264	$C=C^T\ge c_*I$，$c\ge0$，定义
     265	\[
     266	 \mathcal Lv=-\nabla\cdot(C\nabla v)+cv,
     267	 \quad A(z,v)=\ip{C\nabla z}{\nabla v}+\ip{cz}{v},
     268	\]
     269	\begin{equation}\label{eq:weak}
     270	 A(z,v)=-\ip{u\nabla a}{\nabla v},\qquad
     271	 z=\mathcal L^{-1}\nabla\cdot(u\nabla a).
     272	\end{equation}
     273	\end{definition}
     274	Dirichlet 情形由 Poincaré--Lax--Milgram 无核可逆。Neumann 情形需要
     275	$(C\nabla z+u\nabla a)\cdot n=0$，并取 $c\ge c_0>0$，或在均值零商空间满足
     276	compatibility；否则常数核使逆算子无定义。由系数时间不变，
     277	\begin{equation}\label{eq:zt}
     278	 A(z_t,v)=-\ip{u_t\nabla a}{\nabla v},\qquad
     279	 z_t=\mathcal L^{-1}\nabla\cdot(u_t\nabla a).
     280	\end{equation}
     281	
     282	考察研究稿候选
     283	\[
     284	 F=\eta\ip\lambda{\nabla z}+\frac\eta2A(z,z).
     285	\]
     286	\begin{proposition}[候选不抵消]\label{prop:fail}
     287	完整导数为
     288	\begin{align}\label{eq:Fprime}
     289	 \eta^{-1}F'&=\ip{\lambda_t}{\nabla z}+\ip\lambda{\nabla z_t}+A(z,z_t)\\
     290	 &=\ip{\lambda_t}{\nabla z}+\ip{\lambda-u\nabla a}{\nabla z_t}.\notag
     291	\end{align}
     292	因此
     293	\begin{align}\label{eq:totalfail}
     294	 (\E_B+F)'={}&-\D_0-\ip{u\nabla a}{\lambda}+\mathcal B\\
     295	 &+\eta\left[\ip{\lambda_t}{\nabla z}
     296	 +\ip{\lambda-u\nabla a}{\nabla z_t}\right].\notag
     297	\end{align}
     298	特别地，没有出现所需的 $+\ip{u\nabla a}{\lambda}$。
     299	\end{proposition}
     300	\begin{proof}
     301	第一行是两项逐项乘积法则；由 \eqref{eq:weak} 取 $v=z_t$ 得
     302	$A(z,z_t)=-\ip{u\nabla a}{\nabla z_t}$，即第二行。与引理
     303	\ref{lem:identity} 相加得 \eqref{eq:totalfail}。
     304	\end{proof}
     305	
     306	静态方面，$\mathcal L^{-1}\nabla\cdot(u\nabla a):L^2\to H_0^1$ 有界；若
     307	$\eta$ 相对原 $u,\lambda$ 强制性足够小，可以 Schur 补使 $\E_B+F$ 正定且有上界。
     308	但这依赖角域原能量已经等价，且不能修复 \eqref{eq:totalfail}。当 $a\to0$ 时统一下界
     309	消失，故也不能声称全域自然范数等价。
     310	
     311	两个修改也可明确否定。若第二变量 $p=\mathcal L^{-1}\nabla\cdot\lambda$，静态项
     312	$A(z,p)$ 的导数只含 $u_t\lambda+u\lambda_t$ 型项。若引入时间 primitive $r_t=\lambda$，
     313	则
     314	\[
     315	 \frac\dd{\dd t}\ip{u\nabla a}{r}=\ip{u_t\nabla a}{r}+\ip{u\nabla a}{\lambda};
     316	\]
     317	虽抵消目标，却留下第一项；裸交叉项不正定，加入 $\|r\|^2$ 又产生
     318	$\ip r\lambda$，且新 gauge/history 状态不与原范数等价。
     319	
     320	\section{局部交叉项与 Gramian/KYP}
     321	
     322	逐分量严格关系为
     323	\[
     324	 \lambda_{i,t}=\partial_i u_t+\sigma_j\partial_i u-\sigma_i\lambda_i.
     325	\]
     326	因此
     327	\[
     328	 \frac\dd{\dd t}\int c_i u\lambda_i
     329	 =\int c_i[u_t\lambda_i+u\partial_i u_t
     330	 +\sigma_j u\partial_i u-\sigma_i u\lambda_i].
     331	\]
     332	取 $c_i=-\partial_i a/\sigma_i$ 虽产生所需正项，却留下
     333	\[
     334	 -\frac{\partial_i a}{\sigma_i}
     335	 [u_t\lambda_i+u\partial_i u_t+\sigma_j u\partial_i u],
     336	\]
     337	并在内界面奇异。一般局部 symmetrizer $M(x)$ 必须满足
     338	\[
     339	 MA_0^{-1}A_i=(MA_0^{-1}A_i)^T,
     340	\]
     341	\[
     342	 MA_0^{-1}B+(A_0^{-1}B)^TM-sum_i\partial_i(MA_0^{-1}A_i)\ge0,
     343	 \qquad M>0,
     344	\]
     345	即矩阵微分 Lyapunov/Riccati 不等式。本轮没有得到跨 $a=0$ 的正解。
     346	
     347	对相容 strict-ADE 生成元 $A_\sigma$，若在 PEC/transmission 的自然
     348	$H(\operatorname{curl})\times L^2$ history 空间上\emph{预先}生成指数稳定半群，且输出
     349	$C$ 精确可观测，则
     350	\[
     351	 G=\int_0^\infty T(t)^*C^*CT(t)\dd t,
     352	 \qquad A_\sigma^*G+GA_\sigma=-C^*C
     353	\]
     354	给正定等价单调能量。指数稳定保证收敛，精确可观测给下界；这些尚未独立证明，故以
     355	Gramian 证明它们会循环。只有强稳定时积分可发散；有限时域与加权版本分别满足
     356	\[
     357	 \E_T'=\|CT(T)U\|^2-\|CU\|^2,
     358	 \qquad \E_\delta'=-\|CU\|^2+2\delta\E_\delta,
     359	\]
     360	并不自动单调。ratio $(s+\sigma_j)/(s+\sigma_i)$ 虽为 right-half-plane
     361	positive-real，时域指数核系数 $\sigma_j-\sigma_i$ 可变号，必须验证耦合矩阵 kernel/KYP
     362	storage，不能逐分量直接宣布正记忆能量。
