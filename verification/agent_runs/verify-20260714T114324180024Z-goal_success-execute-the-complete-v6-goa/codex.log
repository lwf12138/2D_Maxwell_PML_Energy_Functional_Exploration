      78	\section{严格坐标拉伸模型与时域实现}
      79	
      80	物理 TM 系统为
      81	\begin{align}
      82	 \ep E_t+P_t&=\partial_xH_y-\partial_yH_x,\label{eq:phys1}\\
      83	 \mu H_{x,t}&=-\partial_yE,\qquad \mu H_{y,t}=\partial_xE,\label{eq:phys2}\\
      84	 \tau P_t+P&=\kappa E,\qquad \ep,\mu,\tau,\kappa>0.\label{eq:debye}
      85	\end{align}
      86	在 $\Re s>0$ 取
      87	\[
      88	 S_i=1+\frac{\sigma_i(x_i)}s,\qquad \partial_i\mapsto S_i^{-1}\partial_i,
      89	 \qquad \ep_D(s)=\ep+\frac\kappa{1+\tau s}.
      90	\]
      91	严格频域 PML 是
      92	\begin{align}
      93	 s\ep_D\widehat E&=S_x^{-1}\partial_x\widehat H_y-S_y^{-1}\partial_y\widehat H_x,\label{eq:freq1}\\
      94	 \mu s\widehat H_x&=-S_y^{-1}\partial_y\widehat E,qquad
      95	 \mu s\widehat H_y=S_x^{-1}\partial_x\widehat E.\label{eq:freq2}
      96	\end{align}
      97	
      98	\begin{definition}[Baffet--Debye causal primitive]
      99	令
     100	\[
     101	 u_t=E,\quad q_t=P,\quad q+\tau P=\kappa u,
     102	\quad a=\sx+\sy,\quad b=\sx\sy,
     103	\]
     104	\[
     105	 \Gamma_1=\operatorname{diag}(\sx,\sy),\quad
     106	 \Gamma_2=\operatorname{diag}(\sy-\sx,\sx-\sy),
     107	\]
     108	并取
     109	\begin{align}
     110	 \mu\{\ep(u_{tt}+au_t+bu)+P_t+aP+bq\}-\nabla\cdot\lambda&=0,\label{eq:prim1}\\
     111	 \phi_t+\Gamma_1\phi&=\Gamma_2\nabla u,\qquad \lambda=\nabla u+\phi.\label{eq:prim2}
     112	\end{align}
     113	\end{definition}
     114	
     115	\begin{lemma}[严格等价]
     116	在 causal compatibility manifold 上，\eqref{eq:prim1}--\eqref{eq:prim2} 与
     117	\eqref{eq:freq1}--\eqref{eq:freq2} 对分离变剖面完全等价，且
     118	\[
     119	 \widehat\lambda_x=\frac{S_y}{S_x}\partial_x\widehat u,
     120	 \quad \widehat\lambda_y=\frac{S_x}{S_y}\partial_y\widehat u,
     121	 \quad \widehat\lambda_x=\mu S_y\widehat H_y,
     122	 \quad \widehat\lambda_y=-\mu S_x\widehat H_x.
     123	\]
     124	\end{lemma}
     125	\begin{proof}
     126	对 \eqref{eq:prim2} 作 Laplace 变换，逐分量解一阶代数式即得两个 ratio。把
     127	\eqref{eq:freq1} 乘 $S_xS_y$，再用 \eqref{eq:freq2} 消去磁场及
     128	$\widehat E=s\widehat u$、$\widehat P=s\widehat q$，恰得 \eqref{eq:prim1}。
     129	反向步骤可逆，故不是仅在平面模态上相似。
     130	\end{proof}
     131	
     132	初值需满足 $q(0)+\tau P(0)=\kappa u(0)$、$u_t(0)=E(0)$、
     133	$\lambda(0)=\nabla u(0)+\phi(0)$，PML history 与 causal 过去相容。本文无源
     134	Laplace matching 取 PML 内零历史。剖面满足
     135	$\sigma_i\in W^{1,\infty}$、非负、仅依赖 $x_i$、物理区为零，内界面取连续零迹，
     136	否则跳跃必须作为 transmission distribution/flux 保留。内界面连续切向 $E,H$；外边界
     137	可取 PEC，或任何使总通量非正的条件。阻尼全零时 $\phi=0,\lambda=\nabla u$，退化到
     138	\eqref{eq:phys1}--\eqref{eq:debye} 的 primitive。
     139	
     140	\section{Laplace--Fourier perfect matching}
     141	
     142	考虑 $x=0$，右侧仅 $S_x$，$S_y=1$。取任意实 $k_y$ 与 $\Re s>0$，定义
     143	\[
     144	 \nu_0^2=k_y^2+\mu s^2\ep_D(s).
     145	\]
     146	固定由 causal outgoing resolvent 解析延拓得到的平方根分支，而不是只比较平方。右侧取
     147	\[
     148	 E_+=T\exp\left(ik_yy-\nu_0\int_0^xS_x(s,\xi)\dd\xi\right).
     149	\]
     150	于是 $S_x^{-1}\partial_xE_+=-\nu_0E_+$，在同一法向符号约定下
     151	\[
     152	 Y_+=-\frac{H_y}E=\frac{\nu_0}{\mu s}=Y_0.
     153	\]
     154	由 $1+R=T$、$Y_0(1-R)=Y_+T$，
     155	\[
     156	 R=\frac{Y_0-Y_+}{Y_0+Y_+}=0.
     157	\]
     158	该推导只使用积分坐标，故任意非负法向变剖面仍匹配。它只证明内界面无反射；有限厚
     159	PML 的外边界反射通常非零。角区若仍是同一二维坐标变换，则保持匹配；若 multi-axial
     160	方案在 $x$ 界面引入 $S_y\ne1$，则
     161	\[
     162	 Y_+^2-Y_0^2=\frac{k_y^2}{\mu^2s^2}(S_y^{-2}-1),
     163	\]
     164	斜入射一般失配。
     165	
     166	\section{Baffet 余项与条件单调能量}
     167	
     168	令 $W=u_t+au$。由于 $a$ 与时间无关但依赖空间，
     169	\begin{equation}\label{eq:product}
     170	 \nabla W=\nabla u_t+a\nabla u+u\nabla a.
     171	\end{equation}
     172	定义
     173	\[
     174	 \alpha=1+2a\tau,\quad\beta=a+b\tau,\quad
     175	 \gamma=a^2+b(1+a\tau),
     176	\]
     177	\begin{equation}\label{eq:EB}
     178	\E_B=\frac12\int_{\Om_+}\left\{
     179	 \mu\ep W^2+|\lambda|^2+\phi^Ta^{-1}\Gamma_1\phi+\mu\ep b u^2
     180	 +\frac\mu\kappa(\alpha P^2+2\beta Pq+\gamma q^2)\right\}.
     181	\end{equation}
     182	
     183	\begin{lemma}[完整恒等式]\label{lem:identity}
     184	对足够光滑相容解，
     185	\begin{equation}\label{eq:id}
     186	 \E_B'=-\D_0+R_\sigma+\mathcal B,
     187	 \qquad R_\sigma=-\int_{\Om_+}u\nabla a\cdot\lambda,
     188	 \qquad \mathcal B=\int_{\partial\Om_+}W\lambda\cdot n,
     189	\end{equation}
     190	其中
     191	\begin{align}\label{eq:D0}
     192	\D_0=\int_{\Om_+}\bigg\{&
     193	 \lambda^T\Gamma_1(I+a^{-1}\Gamma_1)\lambda+\frac ba|\nabla u|^2
     194	 +\mu\ep ab u^2\\
     195	&+\frac\mu\kappa[\tau P_t^2+\tau(a^2-b)P^2+abq^2]\bigg\}\ge0.\notag
     196	\end{align}
     197	\end{lemma}
     198	\begin{proof}
     199	以 $W$ 乘 \eqref{eq:prim1}。空间分部积分产生 $-\ip{\nabla W}{\lambda}$ 与
     200	$\mathcal B$。Baffet flux identity 给出
     201	\[
     202	 \frac12\partial_t(|\lambda|^2+\phi^Ta^{-1}\Gamma_1\phi)
     203	 +\lambda^T\Gamma_1(I+a^{-1}\Gamma_1)\lambda+\frac ba|\nabla u|^2
     204	 =(\nabla u_t+a\nabla u)\cdot\lambda.
     205	\]
     206	Debye compatibility 给出
     207	\[
     208	(P_t+aP+bq)(\tau P_t+(1+a\tau)P+aq)
     209	=\frac12\partial_t(\alpha P^2+2\beta Pq+\gamma q^2)
     210	+\tau P_t^2+\tau(a^2-b)P^2+abq^2.
     211	\]
     212	相加后 \eqref{eq:product} 中前两项抵消，留下 $-u\nabla a\cdot\lambda$。
     213	$a^2-b=\sx^2+\sx\sy+\sy^2\ge0$，故 \eqref{eq:D0} 非负。
     214	\end{proof}
     215	
     216	极化矩阵的行列式是
     217	\[
     218	 \alpha\gamma-\beta^2=b+ab\tau+2a^3\tau+b(2a^2-b)\tau^2>0,
     219	\quad 2a^2-b=2\sx^2+3\sx\sy+2\sy^2,
     220	\]
     221	故 Sylvester 判据给出正定。在 $\sx,\sy$ 有统一正下界和上界的角域，$b u^2$ 与
     222	$W^2$ 联合控制 $(u_t,u)$，$a^{-1}\Gamma_1$ 控制 $\phi$，因此 \eqref{eq:EB}
     223	与 $\|(u_t,u,\lambda,\phi,P,q)\|_{L^2}^2$ 等价。边域 $b=0$ 与物理区 $a=0$
     224	在全 primitive 空间有 gauge/退化方向，必须限制到 causal compatibility manifold，或在
     225	物理区拼接缩放自然 Maxwell--Debye 能量。不能把 $a^{-1}$ 公式不加说明地跨过 $a=0$。
     226	
     227	$R_\sigma$ 无固定符号：在开集上取 $u>0$、$\lambda=\mp c\nabla a$ 即得到正负两种符号。
     228	
     229	令
     230	\[

